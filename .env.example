PORT=5174
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=command-r7b
EMBED_MODEL=nomic-embed-text
TOP_K=5
CHAT_NUM_CTX=16384
# Optional: 64-char hex (32-byte) key for encrypting the audit log at rest.
# If unset, a key is auto-generated at server/data/audit-key.bin on first run.
# AUDIT_LOG_KEY=
# Optional: shared admin passphrase for switching the chat model, viewing the
# audit log, and re-running ingestion from the UI. If unset, one is
# auto-generated at server/data/admin-key.txt and printed on server startup.
# ADMIN_KEY=
