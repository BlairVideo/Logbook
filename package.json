{
  "name": "logbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx server/index.ts",
    "ingest": "tsx scripts/ingest.ts",
    "audit:read": "tsx scripts/read-audit-log.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@tailwindcss/vite": "^4.1.11",
    "@types/express": "^4.17.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.6.0",
    "cheerio": "^1.0.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.5",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.9.155",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.11",
    "tesseract.js": "^5.1.1",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "tesseract.js@5.1.1": true
  }
}
